# =============================================================================
# InkSight RDMD - Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# Never commit .env.local to version control
# =============================================================================

# -----------------------------------------------------------------------------
# SYSTEM & DEPLOYMENT
# -----------------------------------------------------------------------------
NIXPACKS_NODE_VERSION=22

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# -----------------------------------------------------------------------------
# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/amorbeauty"

# Enable SSL for database connection (set to true for managed DBs like Neon/Supabase)
# For local Docker PostgreSQL without SSL, keep this false
DATABASE_SSL=false

# -----------------------------------------------------------------------------
# APPLICATION URLS
# -----------------------------------------------------------------------------
# Base URL of the application (client-accessible)
NEXT_PUBLIC_SITE_URL="https://inksight.rdmdstudio.com"

# Auth callback URL
NEXT_PUBLIC_APP_URL="https://inksight.rdmdstudio.com"

# -----------------------------------------------------------------------------
# BETTER AUTH
# -----------------------------------------------------------------------------
# Better Auth configuration
# URL must match your app URL (with protocol)
BETTER_AUTH_URL="https://inksight.rdmdstudio.com"

# Public URL for client-side auth
NEXT_PUBLIC_BETTER_AUTH_URL="https://inksight.rdmdstudio.com"

# Secret key for signing tokens (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET="your-secret-key-here-min-32-chars"

# -----------------------------------------------------------------------------
# S3 STORAGE (RustFS)
# -----------------------------------------------------------------------------
# S3-compatible storage endpoint (RustFS frontend)
S3_ENDPOINT="https://s3-frontend.ranlabs.space"

# Bucket name for file storage
S3_BUCKET="inksight-testing"

# Access credentials from RustFS
S3_ACCESS_KEY="your-access-key"
S3_SECRET_KEY="your-secret-key"

# Public URL for accessing stored files (RustFS public endpoint)
S3_PUBLIC_URL="https://s3.ranlabs.space"

# -----------------------------------------------------------------------------
# EMAIL (Resend)
# -----------------------------------------------------------------------------
# API key for sending emails
RESEND_API_KEY="re_your_resend_api_key"

# -----------------------------------------------------------------------------
# PUSH NOTIFICATIONS (Web Push API / VAPID)
# -----------------------------------------------------------------------------
# VAPID keys for PWA push notifications (generate with: npx web-push generate-vapid-keys)
# VAPID_SUBJECT should be a contact URL or mailto:
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:admin@inksight.rdmdstudio.com"

# -----------------------------------------------------------------------------
# SECURITY (Cloudflare Turnstile)
# -----------------------------------------------------------------------------
# Site key for bot protection on public forms
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-turnstile-site-key"

# -----------------------------------------------------------------------------
# ADMIN VALIDATION (Optional)
# -----------------------------------------------------------------------------
# Bypass admin passkey verification (NOT recommended for production)
# NEXT_PUBLIC_BYPASS_ADMIN_VALIDATION="true"
IT_ADMIN_EMAILS="admin@inksight.rdmdstudio.com"

# -----------------------------------------------------------------------------
# CRON / SCHEDULED TASKS
# -----------------------------------------------------------------------------
# Secret key for authenticating cron job requests (generate with: openssl rand -base64 32)
CRON_SECRET="your-cron-secret-key-here-min-32-chars"