{
    "name": "amorbeauty-system",
    "version": "2026.1.0",
    "private": true,
    "packageManager": "bun@1.1.38",
    "scripts": {
        "dev": "next dev --turbopack --experimental-https",
        "build": "bun run db:push && next build --turbopack",
        "start": "next start",
        "lint": "eslint",
        "typecheck": "tsc --noEmit",
        "merge": "git as-work && git checkout prod && git merge dev && git push origin prod && git checkout dev && git as-personal",
        "invite": "bun run scripts/generate-invite.ts",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:pull": "drizzle-kit pull",
        "db:drop": "drizzle-kit drop",
        "db:studio": "drizzle-kit studio",
        "db:seed": "bun run scripts/seed-database.ts",
        "setup": "bun run scripts/setup-database.ts",
        "validate:env": "bun run scripts/validate-env.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.984.0",
