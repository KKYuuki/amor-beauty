        "@types/bun": "^1.3.11",
        "@types/dompurify": "^3.2.0",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@types/web-push": "^3.6.4",
        "drizzle-kit": "^0.31.10",
