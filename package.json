        "amorbeauty-system": ".",
        "isomorphic-dompurify": "^3.6.0",
        "jspdf": "^3.0.4",
        "jspdf-autotable": "^5.0.2",
        "lucide-react": "^0.544.0",
        "motion": "^12.23.12",
        "nanoid": "^5.1.7",
        "next": "15.5.9",
        "pdf-lib": "^1.17.1",
        "pg": "^8.20.0",
        "qrcode": "^1.5.4",
